# Backend Environment
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://admin:password123@localhost:27017/cat-lai-port?authSource=admin

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d

# TOPX Integration
TOPX_API_URL=http://topx-api.cat-lai.local
TOPX_API_KEY=your-topx-api-key
TOPX_REFRESH_INTERVAL=5000

# ePort Integration
EPORT_API_URL=http://eport-api.cat-lai.local
EPORT_API_KEY=your-eport-api-key

# 5G Telemetry
5G_TELEMETRY_ENDPOINT=ws://5g-gateway.cat-lai.local:8080
5G_RECONNECT_INTERVAL=3000
TELEMETRY_BUFFER_SIZE=10000

# Simulation Engine
DES_SIMULATION_TICK=100
DES_MAX_TIME=86400000

# LiDAR & IoT
LIDAR_API_ENDPOINT=http://lidar-server.cat-lai.local:9000
IOT_MQTT_BROKER=mqtt://iot-broker.cat-lai.local:1883
IOT_SENSOR_INTERVAL=1000

# Redis
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# CORS
CORS_ORIGIN=http://localhost:3000

# Email (for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
